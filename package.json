{
  "name": "xe-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:worker": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "setup": "node scripts/setup.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
