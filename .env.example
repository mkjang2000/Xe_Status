# Run `npm run setup` to generate .env with random credentials.
# Initial password; console changes are stored as a hash in SQLite.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/status.db
NODE_ENV=development
# Production behind an HTTPS reverse proxy:
# NODE_ENV=production
# HOST=0.0.0.0
# APP_ORIGIN=https://status.example.com
# RETENTION_DAYS=90
