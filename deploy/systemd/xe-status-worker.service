[Unit]
Description=XE Status monitoring and notification worker
Wants=network-online.target
After=network-online.target
PartOf=xe-status.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=xe-status
Group=xe-status
WorkingDirectory=/opt/xe-status
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import tsx --env-file=.env worker/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xe-status-worker
